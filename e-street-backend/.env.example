APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails (orders, password resets, seller and server alerts). "log" only writes them to the log file.
# Amazon SES: MAIL_MAILER=smtp, MAIL_HOST=email-smtp.<region>.amazonaws.com (the region elitezaar.com is verified in),
# MAIL_PORT=587, and the SMTP username/password from SES › SMTP settings (not your AWS access keys).
# Check with: php artisan mail:test you@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@elitezaar.com"
MAIL_FROM_NAME="${APP_NAME}"

# Signing in with a mobile number: codes by SMS. SMS_DRIVER: msg91, 2factor, twilio, or log (development: codes
# only go to storage/logs; phone sign-in stays hidden on the live site). Fill in the keys for the one you use.
SMS_DRIVER=log
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Razorpay (https://dashboard.razorpay.com/app/keys). Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Website address, used in emails and to return from Google sign-in.
FRONTEND_URL=http://localhost:5173

# "Continue with Google" (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Add <APP_URL>/api/auth/google/callback under "Authorised redirect URIs". The buttons stay hidden until both keys are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the callback address differs from <APP_URL>/api/auth/google/callback.
GOOGLE_REDIRECT_URI=
# Extra places sign-in may return to, comma-separated. Use "exp://" to test the app in Expo Go (never in production).
GOOGLE_RETURN_URLS=
