{
  "expo": {
    "name": "Elitezaar",
    "description": "Hand-picked clothing and accessories from independent sellers, with UPI, cash on delivery and live order tracking.",
    "slug": "elitezaar",
    "scheme": "elitezaar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elitezaar.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.elitezaar.app",
      "adaptiveIcon": {
        "backgroundColor": "#123a30",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "elitezaar.com", "pathPrefix": "/product" },
            { "scheme": "https", "host": "elitezaar.com", "pathPrefix": "/shop" },
            { "scheme": "https", "host": "elitezaar.com", "path": "/about" },
            { "scheme": "https", "host": "elitezaar.com", "path": "/terms-and-conditions" },
            { "scheme": "https", "host": "elitezaar.com", "path": "/return-refund-policy" },
            { "scheme": "https", "host": "elitezaar.com", "path": "/privacy-policy" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#123a30"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Elitezaar uses your photos so you can add pictures to your product listings."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#18372e",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Elitezaar uses the microphone only while you search by voice.",
          "speechRecognitionPermission": "Elitezaar turns what you say into a product search when you search by voice.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "20af5686-211c-442f-aaea-aa2938d63006"
      }
    }
  }
}
